;; ---------------------------------------------------------------------------
;; Toolchain: Perl
;; Perl runtime, cpan/cpanm, and version-manager paths.
;; Source: 30-toolchains/perl.sb
;; ---------------------------------------------------------------------------

;; Includes common Perl version managers and package/cache locations.

;; Managed Perl builds and local::lib install trees hold interpreters and
;; module-provided scripts that land on the user's PATH, so they are read-only.
;; perlbrew's switch state and the CPAN client build/caches stay writable.
(allow file-read*
    (home-subpath "/.perlbrew")
    (home-subpath "/.plenv")
    (home-subpath "/perl5")
    (home-subpath "/.local/lib/perl5")
)

(allow file-read* file-write*
    (home-literal "/.perlbrew/init")  ;; Written by `perlbrew switch`/`use` to record the active Perl.
    (home-subpath "/.cpan")
    (home-subpath "/.cpanm")
    (home-subpath "/.perl-cpm")
    (home-subpath "/Library/Caches/cpanm")
    (home-literal "/.cpanrc")
)
