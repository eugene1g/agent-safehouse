;; ---------------------------------------------------------------------------
;; Toolchain: Python
;; Python runtime, pip, uv, and virtualenv paths.
;; Source: 30-toolchains/python.sb
;; ---------------------------------------------------------------------------

;; Supports Python installed from:
;; - python.org
;; - brew install python

(allow file-read* file-write*
    ;; CPython
    (home-literal "/.python_history")          ;; REPL history file touched by Python subprocess sessions.

    ;; Environment Manager: pyenv
    (home-subpath "/.pyenv")                   ;; pyenv interpreter shims/versions used by many repos.

    ;; Environment Manager: virtualenvwrapper
    (home-subpath "/.virtualenvs")             ;; virtualenvwrapper default location.

    ;; Linter: Mypy
    (home-subpath "/.cache/mypy")              ;; mypy incremental/type cache.

    ;; Linter: Ruff
    (home-subpath "/.cache/ruff")              ;; Ruff lint/format cache.

    ;; Misc: pre-commit
    (home-subpath "/.cache/pre-commit")        ;; pre-commit hook environment cache.

    ;; Package Manager: conda / miniconda / miniforge
    (home-subpath "/.conda")
    (home-subpath "/miniconda3")
    (home-subpath "/miniforge3")
    (home-literal "/.condarc")

    ;; Package Manager: Hatch
    (home-subpath "/.cache/hatch")
    (home-subpath "/.config/hatch")
    (home-subpath "/.local/share/hatch")

    ;; Package Manager: pip
    (home-subpath "/.cache/pip")               ;; pip cache writes used by Python package installs.
    (home-subpath "/Library/Caches/pip")       ;; macOS pip cache location used by some Python setups.

    ;; Package Manager: pipx
    ;; NOTE: pipx/venvs/, pipx/shared/, and pipx/py/ narrowed to read-only below.
    (home-subpath "/Library/Application Support/pipx")  ;; PIPX_HOME default (pipx 1.16+).
    (home-subpath "/.local/pipx")                       ;; PIPX_HOME legacy, used only if it already exists.
    ;; NOTE: Accepted risk: An agent can tamper with a cached venv that runs outside sandbox
    (home-subpath "/Library/Caches/pipx")               ;; ephemeral `pipx run` venvs (pip backend); reused for up to 14 days.
    (home-subpath "/Library/Logs/pipx")                 ;; Per-invocation logs.

    ;; Package Manager: PDM
    (home-subpath "/.cache/pdm")               ;; PDM dependency/cache data.
    (home-subpath "/.config/pdm")              ;; PDM config files.
    (home-subpath "/.local/share/pdm")         ;; PDM local metadata/state.

    ;; Package Manager: Poetry
    (home-subpath "/.cache/pypoetry")          ;; Poetry dependency cache for Python project tasks.
    (home-subpath "/.config/pypoetry")         ;; Poetry config used during install/publish operations.
    (home-subpath "/.local/share/pypoetry")    ;; Poetry local state and virtualenv metadata.
    (home-subpath "/Library/Caches/pypoetry")  ;; macOS Poetry cache variant.

    ;; Package Manager: uv
    (home-subpath "/.local/share/uv")          ;; uv tool metadata and installed tool/runtime state (tools/ and python/ narrowed to read-only below).
    ;; NOTE: Accepted risk: An agent can tamper with a cached venv that runs outside sandbox
    (home-subpath "/.cache/uv")                ;; download/build cache for fast repeated runs; ephemeral venvs that `uvx` / `uv tool run` reuse

    ;; REPL: IPython
    (home-subpath "/.ipython")                 ;; IPython history/profile data.

    ;; REPL: Jupyter
    (home-subpath "/.jupyter")                 ;; Jupyter runtime/config paths in home.
)

(allow file-read*
    ;; Package Manager: pip
    ;; Config is read-only so an agent cannot repoint index-url.
    ;; Reading it stays allowed so installs from private indexes work.
    (home-subpath "/.config/pip")              ;; pip config reads for index/auth/behavior settings.
    (home-subpath "/.pip")                     ;; Legacy pip config location (~/.pip/pip.conf), still read by pip.

    ;; Package Manager: pip
    ;; Packages and console scripts installed by `pip install --user`.
    ;; Read-only: they run, but cannot be modified.
    (home-subpath "/Library/Python")           ;; PEP 370 user base: ~/Library/Python/3.X/{lib/python/site-packages,bin}.

    ;; Package Manager: Poetry
    (home-subpath "/Library/Application Support/pypoetry/venv")         ;; install location of official installer
    (home-subpath "/Library/Application Support/pypoetry/python")       ;; interpreters installed by `poetry python install`
    ;; NOTE: Credentials in sibling config auth.toml stay unreadable.
    (home-literal "/Library/Application Support/pypoetry/config.toml")  ;; user config

    ;; Package Manager: uv
    (home-subpath "/.config/uv")               ;; uv config reads during tool resolution.
)

;; pip: Cache usage requires ~/Library/Caches to be writable.
(allow file-read-metadata file-write-data
    (home-literal "/Library/Caches")           ;; The directory itself only; creating siblings stays denied.
)

;; pipx: Every subcommand checks that PIPX_MAN_DIR exists before trying to create it.
(allow file-read-metadata
    (home-literal "/.local/share/man")         ;; The directory itself only; man pages stay unreadable.
)

;; pipx:
;; 1. Disallow installs inside sandbox to pipx/venvs.
;; 2. Disallow pipx/shared/ because on PATH.
;; 3. Disallow pipx/py/ because venvs of installed tools use it.
(deny file-write*
    (home-subpath "/Library/Application Support/pipx/venvs")
    (home-subpath "/Library/Application Support/pipx/shared")
    (home-subpath "/Library/Application Support/pipx/py")
    (home-subpath "/.local/pipx/venvs")
    (home-subpath "/.local/pipx/shared")
    (home-subpath "/.local/pipx/py")
)

;; pipx: Disallow moving PIPX_HOME out from under the read-only rules above
;; and moving it back, which would make its venvs/, shared/, and py/ writable.
;; NOTE: Side effect is that PIPX_HOME cannot be created inside the sandbox,
;;       because a directory moved into place is indistinguishable from one
;;       created empty. Therefore pipx subcommands other than `list` and
;;       `environment` work only after pipx has run once outside the sandbox
;;       and created pipx/venvs/, pipx/py/, ~/.local/bin, and ~/.local/share/man.
(deny file-write*
    (home-literal "/Library/Application Support/pipx")
    (home-literal "/.local/pipx")
)

;; Poetry: Resolving the path of pypoetry/venv must stat each ancestor.
(allow file-read-metadata
    (home-literal "/Library/Application Support/pypoetry")
)

;; uv:
;; 1. Disallow installs inside sandbox to uv/tools.
;; 2. Disallow uv/python because venvs created from a uv-managed interpreter
;;    use it as their Python home, including installed tools' venvs and
;;    project venvs that run outside the sandbox.
(deny file-write*
    (home-subpath "/.local/share/uv/tools")
    (home-subpath "/.local/share/uv/python")
)

;; uv: Disallow moving ~/.local/share/uv out from under the read-only rules above
;; and moving it back, which would make its tools/ and python/ writable.
;; NOTE: Side effect is that ~/.local/share/uv cannot be created inside the sandbox,
;;       because a directory moved into place is indistinguishable from one
;;       created empty. Therefore `uvx` / `uv tool run` work only after uv has
;;       created uv/tools/ outside the sandbox, by running `uvx`, `uv tool run`,
;;       or `uv tool install` once.
(deny file-write*
    (home-literal "/.local/share/uv")
)

;; uv: Allow ephemeral tool runs (`uvx` / `uv tool run`) inside an existing uv/tools/.
;; Persistent `uv tool install` remains denied.
(allow file-write*
    (home-literal "/.local/share/uv/tools/.lock")       ;; Cross-process lock uv takes for any tool operation.
    (home-literal "/.local/share/uv/tools/.gitignore")  ;; uv writes this alongside the lock on first use.
    (home-prefix "/.local/share/uv/tools/.tmp")         ;; uv stages the lock as a temp file, then renames it.
)

;; uv: Deny read of index credentials, stored by `uv auth login`.
(deny file-read* file-write*
    (home-subpath "/.local/share/uv/credentials")
)
