;; ---------------------------------------------------------------------------
;; Toolchain: Rust
;; Rust toolchain via rustup/cargo, including config, cache, and optional sccache.
;; Source: 30-toolchains/rust.sb
;; ---------------------------------------------------------------------------

;; Includes common cargo config/cache locations and optional sccache.

;; ~/.cargo/bin holds rustup proxies and `cargo install` binaries, and
;; ~/.rustup holds the managed toolchains behind them, so both roots are
;; read-only. The registry/git caches that ordinary builds write are re-granted
;; below.
(allow file-read*
    (home-subpath "/.cargo")
    (home-subpath "/.rustup")
)

(allow file-read* file-write*
    (home-subpath "/.cargo/registry")        ;; Crate index/source cache written by ordinary `cargo build`.
    (home-subpath "/.cargo/git")             ;; Git dependency checkouts written by ordinary builds.
    (home-literal "/.cargo/.package-cache")  ;; Cargo's cross-process lock file.
    (home-literal "/.cargo/.crates.toml")    ;; Install tracker: cargo opens this read-write even for `install --list`.
    (home-literal "/.cargo/.crates2.json")   ;; Install tracker's JSON companion file; same read-write-on-list behavior.
    (home-subpath "/.config/cargo")
    (home-subpath "/.cache/cargo")
    (home-subpath "/Library/Caches/cargo")
    (home-subpath "/.cache/sccache")
    (home-subpath "/Library/Caches/sccache")
    (home-subpath "/Library/Application Support/Mozilla.sccache")
)
