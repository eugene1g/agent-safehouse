;; ---------------------------------------------------------------------------
;; Agent: GitHub Copilot CLI
;; GitHub Copilot CLI default state/config directory and auth integration.
;; Source: 60-agents/copilot-cli.sb
;; $$command=copilot,copilot-cli$$
;; $$require=55-integrations-optional/keychain.sb$$
;; ---------------------------------------------------------------------------

;; - Homebrew cask installs are covered by the baseline /opt runtime grant.
;; - npm/pnpm global installs commonly expose the launcher via ~/.local/bin or ~/bin.
;; - Copilot CLI keeps config, logs, unpacked package assets, and session state
;;   under ~/.copilot by default (`--config-dir` overrides this at runtime).
;; - The published Node SEA launcher also unpacks its bundled package into
;;   ~/Library/Caches/copilot/pkg/... and resolves the entrypoint via ancestor
;;   lstat/realpath calls. Keep writes scoped to the Copilot cache subtree
;;   itself; the enclosing ~/Library and ~/Library/Caches ancestors only need
;;   metadata traversal on a normal macOS home where those directories exist.

(allow file-read* file-write*
    (home-prefix "/.local/bin/copilot")
    (home-prefix "/bin/copilot")
    (home-subpath "/Library/Caches/copilot")
    (home-subpath "/.copilot")
)

(allow file-read-metadata
    (home-literal "/Library")
    (home-literal "/Library/Caches")
)

;; VS Code Copilot CLI launcher shim
;;
;; VS Code bundles the Copilot Chat extension, which writes a `copilot` launcher
;; into its own global storage and prepends that directory to PATH in every
;; integrated terminal. So inside a VS Code terminal, `safehouse copilot`
;; resolves to the shim rather than to the standalone CLI. That shim locates
;; the real `copilot`, offers to install one when absent, and trampolines to it.
(allow file-read*
    ;; Copilot shim must be readable.
    (home-subpath "/Library/Application Support/Code/User/globalStorage/github.copilot-chat/copilotCli")
    (home-subpath "/Library/Application Support/Code - Insiders/User/globalStorage/github.copilot-chat/copilotCli")

    ;; Frameworks directory must be readable.
    (subpath "/Applications/Visual Studio Code.app/Contents/Frameworks")
    (subpath "/Applications/Visual Studio Code - Insiders.app/Contents/Frameworks")
)
(allow file-read-metadata
    ;; Ancestors of Copilot shim must be metadata-readable.
    (home-literal "/Library/Application Support")
    (home-literal "/Library/Application Support/Code")
    (home-literal "/Library/Application Support/Code/User")
    (home-literal "/Library/Application Support/Code/User/globalStorage")
    (home-literal "/Library/Application Support/Code/User/globalStorage/github.copilot-chat")
    (home-literal "/Library/Application Support/Code - Insiders")
    (home-literal "/Library/Application Support/Code - Insiders/User")
    (home-literal "/Library/Application Support/Code - Insiders/User/globalStorage")
    (home-literal "/Library/Application Support/Code - Insiders/User/globalStorage/github.copilot-chat")
    
    ;; Ancestors of Frameworks directory must be metadata-readable.
    (literal "/Applications")
    (literal "/Applications/Visual Studio Code.app")
    (literal "/Applications/Visual Studio Code.app/Contents")
    (literal "/Applications/Visual Studio Code - Insiders.app")
    (literal "/Applications/Visual Studio Code - Insiders.app/Contents")
)
