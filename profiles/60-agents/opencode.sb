;; ---------------------------------------------------------------------------
;; Agent: OpenCode (v1 and v2)
;; Both versions use the opencode command and the same state/config roots.
;; Source: 60-agents/opencode.sb
;; ---------------------------------------------------------------------------

;; - install script binary locations:
;;   - ~/.opencode/bin/opencode
;;   - $XDG_BIN_DIR/opencode (commonly ~/.local/bin/opencode)
;;   - ~/bin/opencode
;; - local state/config

(allow file-read* file-write*
    (home-prefix "/.opencode/bin/opencode")
    (home-prefix "/.local/bin/opencode")
    (home-prefix "/bin/opencode")
    (home-literal "/.config")                       ;; Needed so mkdir -p can create/update ~/.config/opencode.
    (home-literal "/.cache")                        ;; Needed so mkdir -p can create/update ~/.cache/opencode.
    (home-literal "/.local")                        ;; Needed so mkdir -p can create ~/.local/{share,state}/opencode.
    (home-literal "/.local/share")                  ;; Needed so mkdir -p can create ~/.local/share/opencode.
    (home-literal "/.local/state")                  ;; Needed so mkdir -p can create ~/.local/state/opencode.
    (home-subpath "/.opencode")
    (home-subpath "/.config/opencode")
    (home-subpath "/.cache/opencode")
    (home-subpath "/.local/share/opencode")
    (home-subpath "/.local/share/opentui")
    (home-subpath "/.local/state/opencode")
    (home-literal "/.opencode.json")                ;; Home-dir config file.
)

;; GitHub Copilot token read for auth
(allow file-read*
    (home-subpath "/.config/github-copilot")
)

;; V2 canonicalizes optional config roots and files in every project ancestor.
;; A denied realpath/lstat becomes a fatal location-initialization error (HTTP
;; 500), even for ~/.claude when only its shared agents/skills are needed.
;; Metadata alone is insufficient on macOS. Permit reads of these exact entries,
;; including config file contents and directory listings, but not recursive
;; directory contents or writes. See https://github.com/eugene1g/agent-safehouse/issues/198.
(allow file-read*
    (regex #"/(\.claude|\.agents|\.opencode|opencode\.jsonc?)$")
)
